{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/trust/context-lineage.schema.json",
  "title": "nf-context-lineage/1 上下文血缘（FR-A4-04；prompt/context lineage）",
  "description": "AI 证据的 prompt/context 血缘链：逐段 role+content_digest，prev 前向绑定到 64 个 0 起点；head 与 lineage_digest 绑定模型卡。上下文替换/前缀篡改/跨会话复用必须可检测。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "model_card_digest", "segments", "head", "lineage_digest"],
  "properties": {
    "schema": {"const": "nf-context-lineage/1"},
    "model_card_digest": {"$ref": "#/$defs/digest"},
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {"$ref": "#/$defs/segment"}
    },
    "head": {"$ref": "#/$defs/digest"},
    "lineage_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "role", "content_digest", "prev", "digest"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1, "maximum": 4096},
        "role": {"enum": ["system", "user", "assistant", "tool"]},
        "content_digest": {"$ref": "#/$defs/digest"},
        "prev": {"$ref": "#/$defs/digest"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
