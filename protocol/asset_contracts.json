{
  "chains": [
    {
      "feeds": [
        {
          "input": "docs/verification-cards.md",
          "output": "docs/verification-cards.md"
        }
      ],
      "from": "cards",
      "to": "external-links"
    }
  ],
  "code": [
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system",
        "pickle.loads",
        "marshal.loads"
      ],
      "id": "asset-contract",
      "lang": "python",
      "path": "desktop/src/core/asset_contract.py",
      "tests": [
        "desktop/tests/test_asset_contract.py"
      ]
    },
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system"
      ],
      "id": "json-schema-leaf",
      "lang": "python",
      "path": "desktop/src/core/json_schema.py",
      "tests": [
        "desktop/tests/test_output_forms.py"
      ]
    },
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system"
      ],
      "id": "content-face-leaf",
      "lang": "python",
      "path": "desktop/src/core/content_face.py",
      "tests": [
        "desktop/tests/test_content_face.py"
      ]
    },
    {
      "id": "role-model",
      "path": "desktop/src/core/role_model.py",
      "lang": "python",
      "tests": [
        "desktop/tests/test_role_model.py"
      ],
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system",
        "pickle.loads",
        "marshal.loads"
      ]
    }
  ],
  "data": [
    {
      "id": "pack-outputs-vs-schemas",
      "glob": "community/*/outputs/*.json",
      "format": "json",
      "schema_siblings": [
        "schemas/{stem}.schema.json"
      ],
      "note": "包产物 ↔ 同名 schema 约定（D2 自动发现）：实测 216 对全绿；无 schema 的件计入 no_schema 缺口，不判死"
    },
    {
      "id": "pack-reports-io",
      "glob": "community/*/outputs/REPORT.json",
      "format": "json",
      "schema_siblings": [
        "schemas/{stem}.schema.json",
        "schemas/DOMAIN_REPORT.schema.json"
      ],
      "link": {
        "path_field": "sample",
        "rows_field": "sample_rows"
      },
      "note": "输入输出一致性：REPORT.sample 指向的 CSV 行数必须等于 sample_rows（base 缺省按产物目录与其父目录两候选解析）"
    },
    {
      "id": "pack-cases-csv",
      "glob": "community/*/outputs/samples/CASES.csv",
      "format": "csv",
      "required_any_columns": [
        "case_id",
        "task_id",
        "query_id",
        "bucket"
      ],
      "min_rows": 1,
      "note": "样例集表头**族**各不相同（实测 11 种），故只判「至少含族内一个 id 列」"
    },
    {
      "id": "library-index",
      "path": "library/INDEX.md",
      "format": "markdown"
    },
    {
      "id": "ladder-truth",
      "path": "protocol/LAYERS.json",
      "format": "json",
      "required_fields": [
        "schema",
        "rules",
        "tiers"
      ],
      "sha256": "a167e6e05726dc6e2227e10907a826f7e84b6da98e091b126145cb54e6d9082f"
    },
    {
      "id": "pack-protocol-yaml",
      "glob": "community/*/protocol.yaml",
      "format": "yaml",
      "schema": "protocol/schema/protocol.schema.json",
      "note": "包协议声明：YAML 解析后过 check28 用的同一份 protocol.schema.json（不另造方言）"
    },
    {
      "id": "pack-charts-mermaid",
      "glob": "community/*/outputs/charts/*.mmd",
      "format": "mmd",
      "note": "图表资产：只判「首关键词是合法 Mermaid 图型」，不解析图内容"
    },
    {
      "id": "pack-charts-graphml",
      "glob": "community/*/outputs/**/*.graphml",
      "format": "graphml",
      "min_nodes": 1,
      "note": "图结构资产：XML 良构 + 节点/边计数"
    },
    {
      "id": "asset-contracts-self",
      "path": "protocol/asset_contracts.json",
      "format": "json",
      "required_fields": [
        "schema",
        "data",
        "code",
        "script"
      ],
      "note": "本册自检（自指但可证）：声明件自身必须含 schema 与三面键——check40 因此成为它自己的判据"
    },
    {
      "id": "role-coordinates",
      "path": "protocol/role_coordinates.json",
      "format": "json",
      "required_fields": [
        "schema",
        "counts",
        "kernel",
        "root_digest"
      ],
      "note": "职能坐标冻结投影（ADR-0006）：核内逐件 + 计数 + 摘要；漂移由 role_model 另判"
    }
  ],
  "note": "数字资产契约声明面（三面：data / code / script）。data 面判格式 + 字段完整性 + 防篡改 + 输入输出一致性；code 面判 AST 规范 + 可证空指针 + 测试用例在场（安全漏洞面由 scripts/sast_check.py 的 bandit/ruff-S 计数棘轮与 purity_scan R6 守着，本面不重造第二套口径）；script 面判脚本自带 nf-io 头与声明的双源一致 + 链上 A 输出 ⊆ B 输入。真源单点：改本件即改契约，verify check40 与 nf asset contract 同源消费。",
  "schema": "nf-asset-contracts/1",
  "script": [
    {
      "id": "cards",
      "inputs": [
        "verify.sh"
      ],
      "lang": "python",
      "outputs": [
        "docs/verification-cards.md"
      ],
      "path": "scripts/build_verification_cards.py"
    },
    {
      "id": "geo-export",
      "inputs": [
        "protocol/standards_catalog.json",
        "protocol/standards_binding.json"
      ],
      "lang": "python",
      "outputs": [
        "docs/standards/index.md",
        "docs/standards/answer-cards.md",
        "protocol/geo_export.json",
        "docs/standards/layer-data.md",
        "docs/standards/layer-eng.md",
        "docs/standards/layer-form.md",
        "docs/standards/layer-gov.md",
        "docs/standards/layer-iface.md"
      ],
      "path": "scripts/geo_export.py"
    },
    {
      "id": "external-links",
      "inputs": [
        "README.md",
        "README.en.md",
        "llms.txt",
        "docs/agent/AGENT_START.md",
        "docs/agent/ROUTES.md",
        "docs/verification-cards.md"
      ],
      "lang": "python",
      "outputs": [
        "results/external-links-report.json"
      ],
      "path": "scripts/check_external_links.py"
    },
    {
      "id": "quality-all",
      "inputs": [
        "verify.sh"
      ],
      "lang": "bash",
      "outputs": [],
      "path": "scripts/quality_all.sh"
    }
  ]
}
