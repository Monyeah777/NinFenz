{
  "chains": [
    {
      "feeds": [
        {
          "input": "docs/verification-cards.md",
          "output": "docs/verification-cards.md"
        }
      ],
      "from": "cards",
      "to": "external-links",
      "id": "cards-to-external-links"
    }
  ],
  "code": [
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system",
        "pickle.loads",
        "marshal.loads"
      ],
      "id": "asset-contract",
      "lang": "python",
      "path": "desktop/src/core/asset_contract.py",
      "tests": [
        "desktop/tests/test_asset_contract.py"
      ]
    },
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system"
      ],
      "id": "json-schema-leaf",
      "lang": "python",
      "path": "desktop/src/core/json_schema.py",
      "tests": [
        "desktop/tests/test_output_forms.py"
      ]
    },
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system"
      ],
      "id": "content-face-leaf",
      "lang": "python",
      "path": "desktop/src/core/content_face.py",
      "tests": [
        "desktop/tests/test_content_face.py"
      ]
    },
    {
      "deny_calls": [
        "eval",
        "exec",
        "__import__",
        "os.system",
        "pickle.loads",
        "marshal.loads"
      ],
      "id": "role-model",
      "lang": "python",
      "path": "desktop/src/core/role_model.py",
      "tests": [
        "desktop/tests/test_role_model.py"
      ]
    },
    {
      "forbid_regex": [
        {
          "name": "unsafe",
          "pattern": "\\bunsafe\\b",
          "why": "第二实现线是**只读判据**；unsafe 会把它变成可写面"
        }
      ],
      "glob": "engine/rust/src/**/*.rs",
      "id": "engine-rust-structural",
      "lang": "rust",
      "note": "E2 结构契约（非 AST）：只判禁用式与计数棘轮；完整语法树不在本层范围（ADR-0005 划范围）",
      "regex_limits": [
        {
          "max": 1,
          "name": "extern-c",
          "pattern": "extern\\s+\"C\"",
          "why": "FFI 面只许只减不增（实测 1 处）"
        }
      ]
    },
    {
      "forbid_regex": [
        {
          "name": "unsafe",
          "pattern": "\\bunsafe\\b",
          "why": "第二实现线是只读判据"
        },
        {
          "name": "DllImport",
          "pattern": "\\bDllImport\\b",
          "why": "P/Invoke 面须走显式声明与评审"
        },
        {
          "name": "extern",
          "pattern": "\\bextern\\b",
          "why": "外部符号直接绑定会绕过只读边界"
        }
      ],
      "glob": "engine/dotnet/**/*.cs",
      "id": "engine-dotnet-structural",
      "lang": "cs",
      "note": "同上（实测三类各 0 处，故按零容忍声明）"
    },
    {
      "glob": "engine/rust/ffi/src/**/*.rs",
      "id": "engine-rust-ffi",
      "lang": "rust",
      "note": "F3 治理面（VULN-02，**WARN 起步、不 FAIL**）：FFI 出口必然 unsafe（C ABI 本质），故不套用「禁 unsafe」的只读契约；改判三条可证治理规则——unsafe 前 3 行内须有 SAFETY: 注释 / from_raw_parts 前须挡空指针 / #[no_mangle] 导出面不得 panic。存量清零后把规则迁进 forbid_regex 或新判据升 FAIL",
      "warn_rules": {
        "export_no_panic": {
          "forbid": [
            "panic!",
            ".unwrap(",
            ".expect(",
            "assert!"
          ],
          "pattern": "#\\[no_mangle\\]",
          "skip_after": "#[cfg(test)]"
        },
        "null_guard_before": {
          "guard": "is_null",
          "pattern": "from_raw_parts",
          "skip_after": "#[cfg(test)]",
          "within": 20
        },
        "unsafe_safety_comment": {
          "marker": "SAFETY:",
          "pattern": "\\bunsafe\\b",
          "skip_after": "#[cfg(test)]",
          "within": 3
        }
      }
    }
  ],
  "data": [
    {
      "format": "json",
      "glob": "community/*/outputs/*.json",
      "id": "pack-outputs-vs-schemas",
      "note": "包产物 ↔ 同名 schema 约定（D2 自动发现）：实测 216 对全绿；无 schema 的件计入 no_schema 缺口，不判死",
      "schema_siblings": [
        "schemas/{stem}.schema.json"
      ]
    },
    {
      "format": "json",
      "glob": "community/*/outputs/REPORT.json",
      "id": "pack-reports-io",
      "link": {
        "path_field": "sample",
        "rows_field": "sample_rows"
      },
      "note": "输入输出一致性：REPORT.sample 指向的 CSV 行数必须等于 sample_rows（base 缺省按产物目录与其父目录两候选解析）",
      "schema_siblings": [
        "schemas/{stem}.schema.json",
        "schemas/DOMAIN_REPORT.schema.json"
      ]
    },
    {
      "format": "csv",
      "glob": "community/*/outputs/samples/CASES.csv",
      "id": "pack-cases-csv",
      "min_rows": 1,
      "note": "样例集表头**族**各不相同（实测 11 种），故只判「至少含族内一个 id 列」",
      "required_any_columns": [
        "case_id",
        "task_id",
        "query_id",
        "bucket"
      ]
    },
    {
      "format": "markdown",
      "id": "library-index",
      "path": "library/INDEX.md"
    },
    {
      "format": "json",
      "id": "ladder-truth",
      "path": "protocol/LAYERS.json",
      "required_fields": [
        "schema",
        "rules",
        "tiers"
      ],
      "sha256": "0285b8b1fdf20b9ca9cd0857118cd7f3c09946256d33a6d42028a5c41aad0023"
    },
    {
      "format": "yaml",
      "glob": "community/*/protocol.yaml",
      "id": "pack-protocol-yaml",
      "note": "包协议声明：YAML 解析后过 check28 用的同一份 protocol.schema.json（不另造方言）",
      "schema": "protocol/schema/protocol.schema.json"
    },
    {
      "format": "mmd",
      "glob": "community/*/outputs/charts/*.mmd",
      "id": "pack-charts-mermaid",
      "note": "图表资产：只判「首关键词是合法 Mermaid 图型」，不解析图内容"
    },
    {
      "format": "graphml",
      "glob": "community/*/outputs/**/*.graphml",
      "id": "pack-charts-graphml",
      "min_nodes": 1,
      "note": "图结构资产：XML 良构 + 节点/边计数"
    },
    {
      "format": "json",
      "id": "asset-contracts-self",
      "note": "本册自检（自指但可证）：声明件自身必须含 schema 与三面键——check40 因此成为它自己的判据",
      "path": "protocol/asset_contracts.json",
      "required_fields": [
        "schema",
        "data",
        "code",
        "script"
      ]
    },
    {
      "format": "json",
      "id": "role-coordinates",
      "note": "职能坐标冻结投影（ADR-0006）：核内逐件 + 计数 + 摘要；漂移由 role_model 另判",
      "path": "protocol/role_coordinates.json",
      "required_fields": [
        "schema",
        "counts",
        "kernel",
        "root_digest"
      ]
    }
  ],
  "note": "数字资产契约声明面（三面：data / code / script）。data 面判格式 + 字段完整性 + 防篡改 + 输入输出一致性；code 面判 AST 规范 + 可证空指针 + 测试用例在场（安全漏洞面由 scripts/sast_check.py 的 bandit/ruff-S 计数棘轮与 purity_scan R6 守着，本面不重造第二套口径）；script 面判脚本自带 nf-io 头与声明的双源一致 + 链上 A 输出 ⊆ B 输入。真源单点：改本件即改契约，verify check40 与 nf asset contract 同源消费。",
  "schema": "nf-asset-contracts/1",
