  ],
  "index": [
    {
      "id": "pack-index-selfcontract",
      "glob": "community/*/outputs/INDEX.json",
      "note": "包自述契约（nf-output-index/1）与磁盘实况双向对账：声明件/schema/inputs 必须在场，outputs/ 下的实况必须都被声明（samples/ 夹具除外）"
    }
  ]
