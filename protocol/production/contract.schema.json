{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/production/contract.schema.json",
  "title": "NF 契约（nf-contract/1）",
  "description": "生产/治理双平面的唯一共享边界对象：以 artifact digest + constraints + acceptance 声明双方可校验的约束；状态机覆盖 draft/active/deprecated/retired（WP-01 草案）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "artifact",
    "constraints",
    "acceptance",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "nf-contract/1"
    },
    "id": {
      "type": "string",
      "pattern": "^nf:[^\\s]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "doc",
            "data",
            "code",
            "package"
          ]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "retired"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[0-9]{3}$"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "MUST",
            "SHOULD",
            "MAY"
          ]
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
