{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/production/task.schema.json",
  "title": "NF 有界任务（nf-task/1）",
  "description": "Agent 只在有界槽位内填充：slot 界定范围、spec_refs 界定依据、context_refs 界定上下文、acceptance 界定验收、budget 界定上限（WP-01 草案）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "slot",
    "spec_refs",
    "context_refs",
    "output_schema",
    "acceptance",
    "budget"
  ],
  "properties": {
    "schema": {
      "const": "nf-task/1"
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^slot:[^\\s]+$"
        },
        "kind": {
          "enum": [
            "section",
            "node",
            "field",
            "render"
          ]
        },
        "max_items": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "spec_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/spec_ref"
      }
    },
    "context_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "json",
            "md",
            "text",
            "file"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/acceptance"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "spec_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*:[^\\s]+$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^A-[0-9]{3}$"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
