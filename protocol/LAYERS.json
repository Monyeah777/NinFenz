  "retirement": {
    "playbook": [
      "能力重分派清单：该阶的每项能力落到哪个在役阶或入口面（逐条，不留悬空）。",
      "入口面补齐：能力的新入口必须在场且可用（例：端壳退役 → nf shell 终端 + CLI）。",
      "判据改判 + 记录：受影响的 check 同步改判，退役事实与理由留档（见 docs/L3_FROZEN.md 体例），并登记作者裁决。"
    ],
    "fields": [
      "status",
      "retired_on",
      "retired_reason",
      "redistributed_to"
    ]
  },
  "roles": {
    "note": "职能坐标（ADR-0006）：与抽象阶梯轴**正交**的第二轴——阶梯轴答「在哪一阶」，本轴答「在工坊里干什么」。核内（floor/prod/verify）逐件；核外由规则批量覆盖；两者皆可复算推导，投影 = protocol/role_coordinates.json（nf layers --write）。",
    "vocabulary": [
      "floor",
      "prod",
      "verify",
      "projection",
      "support",
      "app",
      "entry"
    ],
    "kernel_roles": [
      "floor",
      "prod",
      "verify"
    ],
