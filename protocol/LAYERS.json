{
  "schema": "nf-layers/1",
  "note": "NF 抽象阶梯（机制借鉴：多视图架构描述 / 稳定依赖与依赖倒置 / 适应度函数 / 单一真源+生成投影）——**两轴 + 纵切**：抽象轴四阶（契约→资产→引擎→出口，越往下越稳定越贵改）、入口面（只登记角色，永不作为真源）、验证纵切（贯穿四阶的门禁与证据）。本件是阶梯唯一真源；`docs/layers.md` 的阶梯表与 `nf layers` 的输出都是它的投影。命名纪律：本阶梯用「阶 / 面 / 纵切」，不复用 L0-L3（依赖治理编号，见 docs/L3_FROZEN.md）、P00-P80（管线层位）、mount_layers（模块挂载层）与标准目录 layer 四套既有词汇；变更档词表复用 protocol/EXTENSION.md 的 editorial/additive/bump。",
  "vocabulary": {
    "change_tier": [
      "editorial",
      "additive",
      "bump"
    ],
    "status": [
      "active",
      "retired"
    ]
  },
  "rules": [
    {
      "id": "L1-source-in-place",
      "statement": "每阶真源面 / 每资产子级 / 每入口件 / 每纵切件都必须真实存在且非空——声明的路径不许是空气。"
    },
    {
      "id": "L2-tier-exclusive",
      "statement": "四阶真源面两两互斥（展开 glob 后无交集；派生物按 derived 名单显式豁免）——一件不许同时是两阶的真源。"
    },
    {
      "id": "L3-interface-subset",
      "statement": "每阶接口面必须非空且是该阶真源面的子集——接口不能凭空长出真源面外的东西。"
    },
    {
      "id": "L4-dependency-downward",
      "statement": "依赖只许向下：depends_on 指向的阶必须存在、order 更小，且整图无环（稳定依赖方向）。"
    },
    {
      "id": "L5-entry-not-truth",
      "statement": "入口面只登记角色：is_source_of_truth 必须为 false，serves 必须是真实阶 id，入口件必须在场。"
    },
    {
      "id": "L6-no-upward-import",
      "statement": "引擎阶不得反向 import 入口面件（desktop/src/core 不许出现 import nf / from scripts …）——端壳退役的教训：入口可以被替换，真源不行。"
    },
    {
      "id": "L7-retired-not-depended",
      "statement": "退役阶不得被任何在役阶依赖（退役 = 能力已重分派，不是留个空壳在图上）。"
    },
    {
      "id": "L8-judged-by-resolvable",
      "statement": "judged_by 引用的 check 序号必须在 verify.sh 真实存在，assertion:<id> 必须在 protocol/assertions.json 真实登记——判据不许指向不存在的东西。"
    },
    {
      "id": "L9-derived-honest",
      "statement": "derived 名单里的每条 glob 必须至少命中一个真实文件——豁免必须诚实，不许拿豁免当遮羞布。"
    },
    {
      "id": "L10-doc-generated-equal",
      "statement": "docs/layers.md 的生成区必须与该件实时渲染逐字一致（单一真源 + 生成投影）。"
    }
  ],
