{
  "schema": "nf-ai-governance/1",
  "note": "NF-Final §3A D06 机读登记（WP-0F）：AI 面范围 + 影响评估 + 模型风险登记 + 监管映射 + 人类监督。原则：本仓是 AI 辅助的内容生产/装配系统，不是 AI 平台；**只做机制对照，不声称合规/认证**。判据 desktop/tests/test_ai_eval_contract.py。",
  "scope": {
    "system_purpose": "AI 辅助的长内容生产/装配（协议/模块/资产/管线/域包 → LLMWiki → 任务 → 装配 → 交付）",
    "affected_parties": [
      "使用工具的用户",
      "内容读者",
      "仓库维护者"
    ],
    "data_categories": [
      "DC-02（会话/认知记录）",
      "DC-07（评测/模型证据）"
    ],
    "out_of_scope": [
      "模型训练",
      "通用 Agent 监控/取证",
      "托管 GRC/SaaS"
    ],
    "claims_boundary": [
      "不声称合规、认证、高风险系统合格或不可抵赖",
      "监管映射只说明机制对照（mechanism-alignment），不构成法律意见"
    ]
  },
  "impact_assessment": {
    "impact_level": "limited-to-high（取决于用户内容；本仓不判定具体场景分级）",
    "criteria": [
      {
        "id": "IA-01",
        "question": "是否处理特殊类别个人数据？",
        "answer": "本仓不主动处理；用户把此类数据写进内容资产时风险回到用户侧",
        "evidence": [
          "PRIVACY.md"
        ]
      },
      {
        "id": "IA-02",
        "question": "是否有自动化决策影响个人权益？",
        "answer": "否：系统产出内容不直接决定个人权益；交付前有人类复核闸门",
        "evidence": [
          "desktop/src/core/trust/human_review.py"
        ]
      },
      {
        "id": "IA-03",
        "question": "是否有实质人工监督？",
        "answer": "是：人类复核须签名，未签=PENDING（不冒充通过）",
        "evidence": [
          "protocol/trust/human-review.schema.json"
        ]
      },
      {
        "id": "IA-04",
        "question": "是否有可追溯的模型/评测证据？",
        "answer": "是：模型卡绑定模型摘要；替换使旧证据失效",
        "evidence": [
          "desktop/src/core/trust/model_card.py"
        ]
      }
    ],
    "human_oversight": {
      "level": "human-in-the-loop",
      "mechanism": "签名人类复核；未签=PENDING；AI 不能签署",
      "evidence": [
        "desktop/src/core/trust/human_review.py",
        "protocol/trust/human-review.schema.json"
      ]
    },
    "transparency": {
      "mechanism": "AIGC 标识证据可接入（labeling）",
      "evidence": [
        "desktop/src/core/label_ir.py",
        "protocol/trust/human-review.schema.json"
      ]
    },
    "recourse": {
      "mechanism": "模型卡/评测证据绑定 + 人类复核签名；证据不足时显式待定",
      "evidence": [
        "desktop/src/core/trust/model_card.py",
        "desktop/src/core/eval_harness.py"
      ]
    }
  },
