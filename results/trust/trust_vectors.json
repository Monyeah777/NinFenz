{
  "count": 34,
  "cross_language": {
    "note": "Python/Go/.NET parity 在 G4 接线；当前以独立参考实现双算取证。",
    "target": "G4"
  },
  "families": {
    "canonical": 5,
    "domain": 4,
    "entity": 5,
    "level": 7,
    "merkle": 5,
    "pae": 4,
    "process": 4
  },
  "note": "Trust Fabric 测试向量（WP-03）：第三方只读本文件即可自验；期望值由独立参考实现算出，与 core/trust 实现互为双实现。",
  "rules": {
    "admissibility": "entity 先过 nf-entity/1 schema；issuer 须在 policy.issuers；entity.type 须在 issuer.types",
    "canonical": "json.dumps(sort_keys=True, ensure_ascii=False, separators=(',', ':'), allow_nan=False)；只收 int/bool/null/str/list/object；float/NaN/Infinity 拒绝",
    "domain": "sha256(tag_bytes + 0x00 + payload_bytes)；tag 须匹配 ^nf:[a-z0-9-]+:v[1-9][0-9]*:[a-z0-9-]+$",
    "level": "T0 哈希自洽；T1 +签名；T2 +RFC3161；T3 +STH（witness 达阈值）；T4 +公共锚；任一 invalid → exit 1；achieved < required → exit 2",
    "merkle": "RFC 6962：leaf=sha256(0x00||data)，node=sha256(0x01||left||right)；root 在最大 2 的幂处分裂；inclusion proof 自底向上",
    "pae": "DSSEv1 <len(ptype)> <ptype> <len(payload)> <payload>（长度按字节）",
    "process": "step_digest=sha256(tag(nf:process:v1:step)+0x00+canonical(step 去 digest))；prev=上一步 digest（创世=64 个 0）；seq 从 1 连续"
  },
  "schema": "nf-trust-vectors/1",
  "vectors": [
