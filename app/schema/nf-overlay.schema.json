{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-overlay.schema.json",
  "title": "NF 用户覆盖层（nf-overlay/1）",
  "description": "用户改动单独存：条款开关/参数/预设/自定义资产；base 只读，更新不直接改 base。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "base",
    "clauses",
    "params",
    "presets",
    "custom_assets"
  ],
  "properties": {
    "schema": {
      "const": "nf-overlay/1"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "clauses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "text_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {}
    },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "graph"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "graph": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "custom_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "path",
          "sha256"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
