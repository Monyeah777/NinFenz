{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-library/1",
  "type": "object",
  "required": [
    "schema",
    "tags",
    "views",
    "favorites"
  ],
  "properties": {
    "schema": {
      "const": "nf-library/1"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "favorites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tag": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "required": [
        "id",
        "name",
        "query"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string"
        },
        "pack_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
