{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-claim-ledger.schema.json",
  "title": "NF 证据 claim ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "ledger_id", "created_at", "claims", "ledger_sha256"],
  "properties": {
    "schema": {"const": "nf-claim-ledger/1"},
    "ledger_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "created_at": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "ledger_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "status", "evidence_sha256", "source", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "unverified", "rejected"]},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value", "public_key", "key_fingerprint"],
      "properties": {
        "alg": {"const": "ed25519"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
        "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "key_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
