{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-evidence.schema.json",
  "title": "NF 证据随包（nf-evidence/1）",
  "description": "产物摘要 + 输入/计划/图谱 + 校验 + 块级谱系 + 签名；离线可验。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact",
    "input_shas",
    "plan_sha",
    "graph_sha",
    "validation",
    "provenance",
    "signature",
    "tool_versions",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "nf-evidence/1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "input_shas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "plan_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "graph_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "validator",
        "version",
        "errors",
        "warnings"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "validator": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_lineage"
      ],
      "properties": {
        "block_lineage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "block",
              "source_id",
              "transform"
            ],
            "properties": {
              "block": {
                "type": "string",
                "minLength": 1
              },
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "transform": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value",
        "public_key",
        "key_fingerprint"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "schema",
        "validators"
      ],
      "properties": {
        "core": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "validators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
