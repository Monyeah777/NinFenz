{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-project.schema.json",
  "title": "NF 项目（nf-project/1）",
  "description": "项目只存引用（id/version/digest + 文件 path/sha256）+ 状态 + 评审；history append-only 且不计入 digest。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "refs",
    "status",
    "review",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "nf-project/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_pack",
        "graph",
        "spec"
      ],
      "properties": {
        "base_pack": {
          "$ref": "#/$defs/packRef"
        },
        "overlay": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "protocol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "digest"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "$ref": "#/$defs/semver"
            },
            "digest": {
              "$ref": "#/$defs/digest"
            }
          }
        },
        "graph": {
          "$ref": "#/$defs/artifactRef"
        },
        "spec": {
          "$ref": "#/$defs/artifactRef"
        },
        "assembly": {
          "$ref": "#/$defs/artifactRef"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "authoring",
        "assembled",
        "validated",
        "exported",
        "reviewed"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "digest"
        ],
        "properties": {
          "op": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string"
          },
          "digest": {
            "$ref": "#/$defs/digest"
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "packRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "tree": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest",
        "path",
        "sha256"
      ],
      "description": "作者态文件引用：语义身份（id/version）+ 内容摘要（digest）+ 文件身份（path/sha256）；path 为项目内 POSIX 相对路径。",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(^|/)\\.\\.?/)[^\\\\]+$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
