{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-sdir.schema.json",
  "title": "NF 语义文档 IR（nf-sdir/1）",
  "description": "类型化块 + 关系闭包 + 可访问性 + 块级溯源。布局/来源必须显式，缺失不得静默。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "meta",
    "sources",
    "blocks",
    "relations",
    "accessibility",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "nf-sdir/1"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "created_at"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "generator": {
          "type": "string"
        },
        "source_format": {
          "type": "string"
        },
        "lang": {
          "type": "string",
          "minLength": 1
        },
        "fidelity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_format",
            "source_pages",
            "features",
            "unprovenanced_blocks",
            "losses"
          ],
          "properties": {
            "source_format": {
              "type": "string"
            },
            "source_pages": {
              "type": "integer",
              "minimum": 0
            },
            "features": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "unprovenanced_blocks": {
              "type": "integer",
              "minimum": 0
            },
            "losses": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mime",
          "bytes_sha"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mime": {
            "type": "string",
            "minLength": 1
          },
          "bytes_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pages": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "crossref",
              "caption",
              "footnote",
              "toc",
              "index",
              "cite",
              "anchor"
            ]
          }
        }
      }
    },
    "accessibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block",
          "missing"
        ],
        "properties": {
          "block": {
            "type": "string",
            "minLength": 1
          },
          "alt": {
            "type": "string"
          },
          "lang": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "header": {
            "type": "string",
            "minLength": 1
          },
          "reading_order": {
            "type": "integer",
            "minimum": 0
          },
          "missing": {
            "type": "array",
            "items": {
              "enum": [
                "alt",
                "lang",
                "role",
                "header",
                "reading_order"
              ]
            }
          }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "block",
          "source_id",
          "input_hashes",
          "transform"
        ],
        "properties": {
          "block": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "integer",
                "minimum": 0
              },
              "y": {
                "type": "integer",
                "minimum": 0
              },
              "w": {
                "type": "integer",
                "minimum": 0
              },
              "h": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "transform": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "input_hashes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "document",
            "section",
            "heading",
            "paragraph",
            "list",
            "list_item",
            "table",
            "table_row",
            "table_cell",
            "figure",
            "caption",
            "footnote",
            "footnote_ref",
            "crossref",
            "citation",
            "code",
            "math",
            "quote",
            "index"
          ]
        },
        "text": {
          "type": "string"
        },
        "attrs": {
          "type": "object"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "w",
            "h"
          ],
          "properties": {
            "x": {
              "type": "integer",
              "minimum": 0
            },
            "y": {
              "type": "integer",
              "minimum": 0
            },
            "w": {
              "type": "integer",
              "minimum": 0
            },
            "h": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
