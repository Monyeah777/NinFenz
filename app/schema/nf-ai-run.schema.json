{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-ai-run.schema.json",
  "title": "NF AI 运行记录（nf-ai-run/1）",
  "description": "离线/CCOS 交接的 AI 编排记录；禁止密钥字段，不直连模型。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "project_id", "status", "model", "params", "seed", "elapsed_ms", "usage", "tasks", "created_at"],
  "properties": {
    "schema": { "const": "nf-ai-run/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "project_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["queued", "running", "partial", "done", "failed", "cancelled"] },
    "model": { "type": "string", "minLength": 1 },
    "params": { "type": "object" },
    "seed": { "type": "integer" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["planned", "running", "done", "failed", "cancelled", "partial"] }
        }
      }
    },
    "created_at": { "type": "integer", "minimum": 0 }
  }
}