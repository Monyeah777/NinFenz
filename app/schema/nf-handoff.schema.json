{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-handoff/1",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "subject_digest",
    "created_at",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "nf-handoff/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "review_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "app": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "role"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "role": {
          "enum": [
            "project",
            "review",
            "report",
            "markdown",
            "manifest",
            "attachment"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
