{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-pipeline-graph.schema.json",
  "title": "NF 作者管线图（nf-pipeline-graph/1）",
  "description": "作者态 DAG：节点/边/权重/参数/绑定。合法 DAG、端口、必需阶段、模式限制由核心校验；本 schema 只钉结构。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "mode",
    "nodes",
    "edges",
    "weights",
    "params",
    "settings"
  ],
  "properties": {
    "schema": {
      "const": "nf-pipeline-graph/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "simple",
        "pro",
        "expert"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {}
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_stages"
      ],
      "properties": {
        "required_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^N[0-9]{2,3}$"
          }
        },
        "seed": {
          "type": "integer"
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "max_chars": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "x-digest-exclude": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "ports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^N[0-9]{2,3}$"
        },
        "kind": {
          "enum": [
            "stage",
            "module",
            "asset",
            "gate",
            "merge",
            "branch"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "module_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {}
        },
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "in",
            "out"
          ],
          "properties": {
            "in": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "out": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "from_port",
        "to_port",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^E[0-9]{2,3}$"
        },
        "from": {
          "type": "string",
          "pattern": "^N[0-9]{2,3}$"
        },
        "to": {
          "type": "string",
          "pattern": "^N[0-9]{2,3}$"
        },
        "from_port": {
          "type": "string",
          "minLength": 1
        },
        "to_port": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "data",
            "control"
          ]
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
