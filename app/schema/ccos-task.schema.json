{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/ccos-task.schema.json",
  "title": "CCOS 执行任务（ccos-task/1）",
  "description": "APP 生成的执行任务；密钥/预算/策略只在 CCOS，任务只声明策略不携带密钥。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "created_at",
    "pack",
    "protocol",
    "pipeline",
    "md_spec",
    "inputs",
    "variables",
    "constraints",
    "acceptance",
    "budget",
    "policy",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "ccos-task/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "created_at": {
      "type": "string"
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "md_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot",
          "value"
        ],
        "properties": {
          "slot": {
            "type": "string",
            "pattern": "^SLT-[0-9]{2,3}$"
          },
          "value": {}
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {}
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_tokens",
        "max_chars",
        "max_seconds"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "tools",
        "secrets"
      ],
      "properties": {
        "network": {
          "const": false
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secrets": {
          "const": "ccos-only"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "project_digest",
        "app_version"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "project_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "app_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
