{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-source-chain.schema.json",
  "title": "NF 来源链（nf-source-chain/1）",
  "description": "来源摘要哈希链；改任一环可定位断点，可离线验链。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries", "head", "digest"],
  "properties": {
    "schema": { "const": "nf-source-chain/1" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "prev"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "prev": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" }
        }
      }
    },
    "head": { "type": "string", "pattern": "^$|^[0-9a-f]{64}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}