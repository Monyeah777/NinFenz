{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-patch/1",
  "title": "NF semantic patch",
  "type": "object",
  "required": [
    "schema",
    "ops"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "nf-patch/1"
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_ids": {
          "type": "array",
          "maxItems": 5000,
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "op": {
            "enum": [
              "replace",
              "insert",
              "delete",
              "move",
              "set-slot"
            ]
          },
          "block_id": {
            "type": "string",
            "maxLength": 64
          },
          "after_block_id": {
            "type": "string",
            "maxLength": 64
          },
          "index": {
            "type": "integer",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "maxLength": 200000
          },
          "slot": {
            "type": "string",
            "maxLength": 200
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "op": {
                  "const": "replace"
                }
              },
              "required": [
                "op"
              ]
            },
            "then": {
              "required": [
                "block_id",
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "insert"
                }
              },
              "required": [
                "op"
              ]
            },
            "then": {
              "required": [
                "text"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "delete"
                }
              },
              "required": [
                "op"
              ]
            },
            "then": {
              "required": [
                "block_id"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "move"
                }
              },
              "required": [
                "op"
              ]
            },
            "then": {
              "required": [
                "block_id"
              ],
              "anyOf": [
                {
                  "required": [
                    "after_block_id"
                  ]
                },
                {
                  "required": [
                    "index"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "op": {
                  "const": "set-slot"
                }
              },
              "required": [
                "op"
              ]
            },
            "then": {
              "required": [
                "slot",
                "text"
              ]
            }
          }
        ]
      }
    }
  }
}
