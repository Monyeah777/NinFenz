{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-protocol-pack.schema.json",
  "title": "NF 协议包（nf-protocol-pack/1）",
  "description": "条款/字段/规则/示例/兼容/迁移。规则为封闭 JSON 表达式 DSL（op 白名单），不得携带可执行脚本。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "proto_version",
    "clauses",
    "fields",
    "rules",
    "examples",
    "compat",
    "migrations"
  ],
  "properties": {
    "schema": {
      "const": "nf-protocol-pack/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "proto_version": {
      "type": "integer",
      "minimum": 1
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/clause"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/example"
      }
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_min",
        "protocol_max",
        "app_min"
      ],
      "properties": {
        "protocol_min": {
          "type": "integer",
          "minimum": 1
        },
        "protocol_max": {
          "type": "integer",
          "minimum": 1
        },
        "app_min": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "migrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "steps"
        ],
        "properties": {
          "from": {
            "type": "integer",
            "minimum": 1
          },
          "to": {
            "type": "integer",
            "minimum": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "$defs": {
    "clause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "level",
        "text",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^C-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "enum": [
            "MUST",
            "SHOULD",
            "MAY"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^F-[0-9]{3}$"
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "anchor": {
              "type": "string"
            }
          }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "clause",
        "label",
        "type",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "clause": {
          "type": "string",
          "pattern": "^C-[0-9]{3}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "number",
            "bool",
            "enum",
            "path",
            "json"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraint": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "max_len": {
              "type": "integer",
              "minimum": 0
            },
            "pattern": {
              "type": "string"
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "expr",
        "severity",
        "message",
        "fix"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[0-9]{3}$"
        },
        "expr": {
          "$ref": "#/$defs/expr"
        },
        "severity": {
          "enum": [
            "error",
            "warn"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "enum": [
            "and",
            "or",
            "not",
            "eq",
            "ne",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "matches",
            "exists",
            "len"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operand"
          }
        },
        "field": {
          "type": "string",
          "pattern": "^F-[0-9]{3}$"
        },
        "value": {}
      }
    },
    "operand": {
      "oneOf": [
        {
          "$ref": "#/$defs/expr"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field"
          ],
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^F-[0-9]{3}$"
            }
          }
        },
        {
          "type": [
            "string",
            "integer",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "keywords",
        "body"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EX-[0-9]{2}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
