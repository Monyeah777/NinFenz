{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-validate-report.schema.json",
  "title": "NF 校验报告（nf-validate-report/1）",
  "description": "逐 issue 定位（path + fix）；verdict 只能由 issues 推出；同输入两次报告逐字节一致。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "target",
    "level",
    "issues",
    "summary",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "nf-validate-report/1"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "digest"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "level": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "warn",
        "info"
      ],
      "properties": {
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warn": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "enum": [
        "pass",
        "warn",
        "fail"
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "path",
        "message",
        "fix"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^NF-[A-Z]+-[0-9]{3}$"
        },
        "severity": {
          "enum": [
            "error",
            "warn",
            "info"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fix": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string"
        }
      }
    }
  }
}
