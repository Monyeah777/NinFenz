{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-review/1",
  "type": "object",
  "required": [
    "schema",
    "project_id",
    "subject_digest",
    "comments",
    "verdict"
  ],
  "properties": {
    "schema": {
      "const": "nf-review/1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/comment"
      }
    },
    "verdict": {
      "enum": [
        "pending",
        "pass",
        "reject"
      ]
    },
    "reviewer": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "comment": {
      "type": "object",
      "required": [
        "id",
        "block_id",
        "block_digest",
        "author",
        "body",
        "status",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "block_id": {
          "type": "string",
          "minLength": 1
        },
        "block_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "unresolved",
            "resolved"
          ]
        },
        "created_at": {
          "type": "integer",
          "minimum": 0
        },
        "resolved_at": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
