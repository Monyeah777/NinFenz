{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-preset.schema.json",
  "title": "NF 预设",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "version", "settings"],
  "properties": {
    "schema": {"const": "nf-preset/1"},
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {"enum": ["SYSTEM", "LIGHT", "DARK"]},
        "language": {"type": "string", "minLength": 2},
        "density": {"enum": ["compact", "standard", "comfortable"]},
        "profile": {"type": "string", "minLength": 1},
        "typeScale": {"type": "number", "minimum": 0.8, "maximum": 2.0}
      }
    },
    "extensions": {"type": "array", "items": {"type": "string"}}
  }
}
