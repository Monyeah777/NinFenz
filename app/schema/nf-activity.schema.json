{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-activity/1",
  "type": "object",
  "required": [
    "schema",
    "events"
  ],
  "properties": {
    "schema": {
      "const": "nf-activity/1"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "minItems": 1
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "event": {
      "type": "object",
      "required": [
        "id",
        "at",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "project.create",
            "project.update",
            "project.delete",
            "pack.install",
            "pack.remove",
            "export",
            "review",
            "restore",
            "other"
          ]
        },
        "project_id": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
