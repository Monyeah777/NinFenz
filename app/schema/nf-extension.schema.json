{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-extension.schema.json",
  "title": "NF 声明式扩展（nf-extension/1）",
  "description": "只允许声明式扩展，不执行任意代码；严格模式拒绝未签名。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "type",
    "compat",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "nf-extension/1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "adapter",
        "renderer",
        "validator",
        "theme",
        "preset",
        "bundle"
      ]
    },
    "compat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_app_version",
        "schema_version"
      ],
      "properties": {
        "min_app_version": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alg",
        "value",
        "public_key",
        "key_fingerprint"
      ],
      "properties": {
        "alg": {
          "const": "ed25519"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "key_fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "import",
          "library",
          "author",
          "delivery",
          "export",
          "settings",
          "review",
          "inbox",
          "ccos",
          "pack"
        ]
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/contribution"
      }
    }
  },
  "$defs": {
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "config"
      ],
      "properties": {
        "kind": {
          "enum": [
            "import_recipe",
            "saved_view",
            "smart_collection",
            "spec_snippet",
            "clause_library",
            "graph_recipe",
            "delivery_variant",
            "slot_transform",
            "export_profile",
            "output_rule",
            "preflight_profile",
            "workspace_preset",
            "review_checklist",
            "assembly_recipe"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "config": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
