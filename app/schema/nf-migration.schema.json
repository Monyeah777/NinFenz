{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-migration.schema.json",
  "title": "NF 数据/格式迁移计划",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "from_schema", "to_schema", "steps", "losses"],
  "properties": {
    "schema": {"const": "nf-migration/1"},
    "from_schema": {"type": "string", "minLength": 1},
    "to_schema": {"type": "string", "minLength": 1},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "losses": {"type": "array", "items": {"type": "string"}},
    "reversible": {"type": "boolean"}
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "from", "to", "reversible"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "from": {"type": "string", "minLength": 1},
        "to": {"type": "string", "minLength": 1},
        "reversible": {"type": "boolean"}
      }
    }
  }
}
