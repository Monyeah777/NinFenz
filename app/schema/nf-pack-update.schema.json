{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/nf-pack-update.schema.json",
  "title": "NF Pack 更新计划（nf-pack-update/1）",
  "description": "base+overlay 更新：added/removed/modified + impact + merge + conflicts；冲突不得静默丢。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "from",
    "to",
    "changes",
    "impact",
    "merge",
    "conflicts",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "nf-pack-update/1"
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "tree"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "tree": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "modified"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "modified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256",
              "new_sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "new_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "breaking",
        "projects",
        "overlay_keys"
      ],
      "properties": {
        "breaking": {
          "type": "boolean"
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overlay_keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "on_conflict"
      ],
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "path",
              "reason"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "keep_local",
                  "take_new",
                  "merge",
                  "defer"
                ]
              },
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        },
        "on_conflict": {
          "enum": [
            "require_user",
            "abort"
          ]
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auto_merge",
        "backup",
        "rollback"
      ],
      "properties": {
        "auto_merge": {
          "type": "boolean"
        },
        "backup": {
          "type": "boolean"
        },
        "rollback": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "options",
        "default"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CFL-[0-9]{2}$"
        },
        "kind": {
          "enum": [
            "delete",
            "rename",
            "schema"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "old_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "new_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "keep_mine",
              "take_new",
              "defer"
            ]
          }
        },
        "default": {
          "enum": [
            "keep_mine",
            "take_new",
            "defer"
          ]
        }
      }
    }
  }
}
