{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/app/schema/ccos-result.schema.json",
  "title": "CCOS 执行结果（ccos-result/1）",
  "description": "结果：artifacts/evidence/report/provenance；必须回钉 task_digest；人审确认恒为必需。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "task_digest",
    "status",
    "artifacts",
    "evidence",
    "report",
    "provenance",
    "human_review"
  ],
  "properties": {
    "schema": {
      "const": "ccos-result/1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"
    },
    "task_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "partial"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mime",
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "mime": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "digest"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "issues"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "severity",
              "path",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^NF-[A-Z]+-[0-9]{3}$"
              },
              "severity": {
                "enum": [
                  "error",
                  "warn",
                  "info"
                ]
              },
              "path": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "engine": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "started_at": {
          "type": "string"
        },
        "finished_at": {
          "type": "string"
        }
      }
    },
    "human_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "reviewer": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
