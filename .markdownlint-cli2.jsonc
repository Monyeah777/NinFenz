{
  "config": ".markdownlint.json",
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "**/node_modules/**",
    "community/**",
    "packaging/npm/payload/**",
    "results/**",
    "library/NF-*.md",
    "library/anchors/**"
  ],
  "_why_ignores": {
    "community/ + library/NF-*": "第三方投稿正文（版权归投稿人；正文形态不归本仓结构规则，由 library/ frontmatter 真源与许可证门单独守）",
    "results/**": "审计流水账与取证档案（机器产出的过程记录，不是文档入口面）",
    "packaging/npm/payload/**": "npm 发布物镜像树（生成物，由 payload 清单门禁守）"
  }
}
