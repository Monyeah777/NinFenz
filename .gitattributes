# 仓库 EOL / 编码纪律（RFC 3629：UTF-8；行尾：LF）
# 与 verify check33「编码卫生」门禁同源：属性优先于 core.autocrlf，
# 保证 Windows / Linux / macOS 工作区字节一致（摘要与逐字节复现的前提）。
* text=auto eol=lf

# 二进制面：禁行尾转换（转换会破坏字节）
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.gz binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary

# 生成物/基线类：文本但禁 diff 噪声
protocol/asset_line_baseline.json text eol=lf
protocol/generated/*.json text eol=lf

# 平台脚本面：保持 CRLF 的仅限显式声明件
*.bat text eol=crlf

# 脚本强制 LF（FX-09）：判据是索引里的实际存储行尾，不是规则文本；
# gitattributes 通配对子目录同样生效（实测 scripts/*.sh、site/*.sh 均 i/lf）。
*.sh text eol=lf
*.bash text eol=lf

# 导出去噪（FX-11）：git archive 产物只留交付物，开发侧文件不进 tarball。
# 边界：GitHub 自动源码包不遵守 .gitattributes，本规则只对 git archive 生效。
.editorconfig export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.pre-commit-config.yaml export-ignore
.env.example export-ignore
