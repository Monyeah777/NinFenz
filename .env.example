# 环境模板（FX-04）：全部为占位符，复制成 .env 后按需填写；真实凭据一律不进仓。
NF_ENV=production
NF_LOG_LEVEL=info
NF_HOME=/path/to/nf-home
NF_HTTP_PROXY=http://127.0.0.1:0000
NF_MODEL_ENDPOINT=https://example.invalid/v1
NF_MODEL_API_KEY=EXAMPLE-not-a-real-key
NF_QQ_BRIDGE_TOKEN=EXAMPLE-not-a-real-token
NF_SIGNING_KEY_PATH=/path/to/EXAMPLE-key.pem
