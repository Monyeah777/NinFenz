    {"dimension": "claim_linkage", "primitive": "linkage",
     "unit": "ratio", "threshold": 1.0, "granularity": 0.333,
     "min_effect": 0.333, "max_missing": 0},
    {"dimension": "real_id_validity", "primitive": "check_ref",
