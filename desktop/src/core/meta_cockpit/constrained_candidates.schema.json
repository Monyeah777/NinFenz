{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/schema/constrained-candidates/1",
  "title": "NF Constrained Cockpit Candidate Envelope",
  "description": "System-owned safe candidate envelope. The model selects one index or stops; it cannot add atoms, scores, or a full plan.",
  "type": "object",
  "required": ["schema", "goal", "turn", "unmet", "agenda", "task_profile",
               "facet_agenda", "coherence", "candidates", "constraints",
               "candidate_context", "state_view", "method_cards",
               "graph_slice", "evidence_roles", "context"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "nf-constrained-candidates/1"},
    "goal": {"type": "string", "minLength": 1},
    "turn": {"type": "integer", "minimum": 0},
    "unmet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["structure", "relations", "risks", "synthesis",
                 "grounding", "resolve"]
      }
    },
    "agenda": {
      "type": "object",
      "required": ["schema", "turn", "obligations", "gaps", "digest",
                   "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-epistemic-agenda/1"},
        "turn": {"type": "integer", "minimum": 0},
        "obligations": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["id", "need", "status", "witness", "closure"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^epistemic:[a-z_]+$"},
              "need": {
                "enum": ["structure", "relations", "risks", "synthesis",
                         "grounding", "resolve"]
              },
              "status": {"enum": ["open", "weak", "satisfied"]},
              "witness": {"type": "string", "minLength": 1},
              "closure": {"type": "string", "minLength": 1}
            }
          }
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["structure", "relations", "risks", "synthesis",
                     "grounding", "resolve"]
          }
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "no_scoring": {"const": true}
      }
    },
    "task_profile": {
      "type": "object",
      "required": ["schema", "catalog_version", "catalog_digest", "primary",
                   "modes", "facets", "required_facets", "functions",
                   "context_roles",
                   "preferred_atoms",
                   "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-task-profile/1"},
        "catalog_version": {"type": "string", "minLength": 1},
        "catalog_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "primary": {
          "enum": ["compare", "diagnose", "design", "audit", "explain",
                   "decide", "create", "general"]
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["compare", "diagnose", "design", "audit", "explain",
                     "decide", "create", "general"]
          }
        },
        "facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "required_facets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["knowledge", "monitoring", "control",
                     "evaluation", "integration"]
          }
        },
        "context_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "preferred_atoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z]\\.[a-z_]+$"}
        },
        "no_scoring": {"const": true}
      }
    },
    "facet_agenda": {
      "type": "object",
      "required": ["schema", "items", "gaps", "repair_keys", "digest",
                   "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-task-facets/1"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["facet", "status", "witnesses"],
            "additionalProperties": false,
            "properties": {
              "facet": {"type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"},
              "status": {"enum": ["open", "closed"]},
              "witnesses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["keys"],
                  "additionalProperties": false,
                  "properties": {
                    "keys": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {"type": "string"}
                    },
                    "min_items": {"type": "integer", "minimum": 1},
                    "min_chars": {"type": "integer", "minimum": 1},
                    "item_keys": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    },
                    "allow_empty": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {"type": "string", "minLength": 1}
                    }
                  }
                }
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "repair_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "no_scoring": {"const": true}
      }
    },
    "coherence": {
      "type": "object",
      "required": ["schema", "status", "invariants", "issues", "digest",
                   "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-coherence/1"},
        "status": {"enum": ["pass", "fail"]},
        "invariants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "status", "issues"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["pass", "fail"]},
              "issues": {
                "type": "array",
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "issue"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "issue": {"type": "string", "minLength": 1}
            }
          }
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "no_scoring": {"const": true}
      }
    },
    "candidate_context": {
      "type": "object",
      "required": ["anchor_cluster", "repair_keys", "preferred_atoms",
                   "desired_functions", "candidate_limit",
                   "bounded_progress_pool", "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "anchor_cluster": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "repair_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "preferred_atoms": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "desired_functions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["knowledge", "monitoring", "control",
                     "evaluation", "integration"]
          }
        },
        "candidate_limit": {"const": 5},
        "bounded_progress_pool": {"const": 48},
        "no_scoring": {"const": true}
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["cluster", "resolves", "cost", "kind", "effect",
                     "contract", "basis"],
        "additionalProperties": false,
        "properties": {
          "cluster": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z]\\.[a-z_]+$"}
          },
          "resolves": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": ["structure", "relations", "risks", "synthesis",
                       "grounding", "resolve"]
            }
          },
          "cost": {"type": "integer", "minimum": 1, "maximum": 3},
          "kind": {"enum": ["direct", "prepare", "compiled"]},
          "effect": {
            "type": "object",
            "required": ["adds", "removes"],
            "additionalProperties": false,
            "properties": {
              "adds": {"type": "array", "uniqueItems": true,
                       "items": {"type": "string"}},
              "removes": {"type": "array", "uniqueItems": true,
                          "items": {"type": "string"}}
            }
          },
          "contract": {
            "type": "object",
            "required": ["schema", "atom_ids", "meta_functions",
                         "meta_levels", "patch_keys", "context_roles",
                         "closure_rules", "patch_required"],
            "additionalProperties": false,
            "properties": {
              "schema": {"const": "nf-thought-contract/1"},
              "atom_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z]\\.[a-z_]+$"}
              },
              "meta_functions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": ["knowledge", "monitoring", "control",
                           "evaluation", "integration"]
                }
              },
              "meta_levels": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"enum": ["M0", "M1", "M2", "M3", "M4"]}
              },
              "patch_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
              },
              "context_roles": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "closure_rules": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "patch_required": {"const": false}
            }
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "required": ["max_atoms", "max_cost", "no_scoring", "no_full_plan",
                   "thought_patch_mode"],
      "additionalProperties": false,
      "properties": {
        "max_atoms": {"const": 3},
        "max_cost": {"const": 3},
        "no_scoring": {"const": true},
        "no_full_plan": {"const": true},
        "thought_patch_mode": {"const": "optional"}
      }
    },
    "state_view": {
      "type": "object",
      "required": ["turn", "artifact", "open_questions",
                   "available_keys", "unmet", "method_history"],
      "additionalProperties": false,
      "properties": {
        "turn": {"type": "integer", "minimum": 0},
        "artifact": {"type": "object"},
        "open_questions": {"type": "array", "items": {"type": "string"}},
        "available_keys": {"type": "array", "uniqueItems": true,
                           "items": {"type": "string"}},
        "unmet": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["structure", "relations", "risks", "synthesis",
                     "grounding", "resolve"]
          }
        },
        "method_history": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["turn", "cluster", "resolved", "changed_keys",
                         "kind", "state_signature"],
            "additionalProperties": false,
            "properties": {
              "turn": {"type": "integer", "minimum": 1},
              "cluster": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^[a-z]\\.[a-z_]+$"}
              },
              "resolved": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": ["structure", "relations", "risks", "synthesis",
                           "grounding", "resolve"]
                }
              },
              "changed_keys": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string"}
              },
              "kind": {"enum": ["direct", "prepare", "compiled"]},
              "state_signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "method_cards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "function", "level_min", "level_max",
                     "input", "output", "trigger", "failure_mode"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z]\\.[a-z_]+$"},
          "name": {"type": "string", "minLength": 1},
          "function": {"enum": ["knowledge", "monitoring", "control",
                                "evaluation", "integration"]},
          "level_min": {"type": "string", "pattern": "^M[0-4]$"},
          "level_max": {"type": "string", "pattern": "^M[0-4]$"},
          "input": {"type": "array", "items": {"type": "string"}},
          "output": {"type": "array", "items": {"type": "string"}},
          "trigger": {"type": "string", "minLength": 1},
          "failure_mode": {"type": "string", "minLength": 1}
        }
      }
    },
    "graph_slice": {
      "type": "object",
      "required": ["anchors", "nodes", "edges", "matched_concepts",
                   "domain_nodes", "warnings", "sources", "omission"],
      "additionalProperties": false,
      "properties": {
        "anchors": {"type": "array", "uniqueItems": true,
                    "items": {"type": "string"}},
        "nodes": {"type": "array", "uniqueItems": true,
                  "items": {"type": "string"}},
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "kind", "source"],
            "additionalProperties": false,
            "properties": {
              "from": {"type": "string", "minLength": 1},
              "to": {"type": "string", "minLength": 1},
              "kind": {"enum": ["nf-mapping", "state-relation",
                                "domain-prerequisite"]},
              "source": {"type": "string", "minLength": 1}
            }
          }
        },
        "matched_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "domain_nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "concept", "layer", "source"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "concept": {"type": "string"},
              "layer": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "kind", "cycle"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string"},
              "kind": {"type": "string"},
              "cycle": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "path", "kind", "file_digest"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string"},
              "path": {"type": "string"},
              "kind": {"const": "graph-source"},
              "file_digest": {"type": "string",
                              "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "omission": {
          "type": "object",
          "required": ["reason", "unmapped_anchors"],
          "additionalProperties": false,
          "properties": {
            "reason": {"const": "one-hop NF neighborhood only"},
            "unmapped_anchors": {"type": "array", "uniqueItems": true,
                                 "items": {"type": "string"}}
          }
        }
      }
    },
    "evidence_roles": {
      "type": "object",
      "required": ["schema", "requested", "roles", "gaps", "unknown",
                   "digest", "no_scoring"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-evidence-roles/1"},
        "requested": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["role", "status", "source_ids",
                         "excerpt_digests", "graph_edges"],
            "additionalProperties": false,
            "properties": {
              "role": {"type": "string",
                       "pattern": "^[a-z][a-z0-9-]*$"},
              "status": {
                "enum": ["available", "context-only", "advisory-only",
                         "missing"]
              },
              "source_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "excerpt_digests": {
                "type": "array",
                "uniqueItems": true,
                "items": {"type": "string",
                          "pattern": "^[0-9a-f]{64}$"}
              },
              "graph_edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["from", "to", "kind", "source"],
                  "additionalProperties": false,
                  "properties": {
                    "from": {"type": "string", "minLength": 1},
                    "to": {"type": "string", "minLength": 1},
                    "kind": {"type": "string", "minLength": 1},
                    "source": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "unknown": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "no_scoring": {"const": true}
      }
    },
    "context": {
      "type": "object",
      "required": ["schema", "references", "stable_prefix_digest",
                   "dynamic_digest", "sources", "budget", "cache"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "nf-cockpit-context/1"},
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "role", "trust", "path", "line", "text", "truncated",
                         "char_start", "char_end", "normalization", "matched_terms",
                         "content_digest", "file_digest"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "role": {"enum": ["content", "domain-content", "domain-output",
                                "domain-scope", "external-content"]},
              "trust": {"enum": ["local-trusted", "external-advisory",
                                 "derived"]},
              "path": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1},
              "text": {"type": "string", "minLength": 1},
              "truncated": {"type": "boolean"},
              "char_start": {"type": "integer", "minimum": 0},
              "char_end": {"type": "integer", "minimum": 1},
              "normalization": {"const": "none"},
              "matched_terms": {"type": "array", "uniqueItems": true,
                                "items": {"type": "string"}},
              "matched_roles": {"type": "array", "uniqueItems": true,
                                "items": {"type": "string"}},
              "content_digest": {"type": "string",
                                 "pattern": "^[0-9a-f]{64}$"},
              "file_digest": {"type": "string",
                              "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "stable_prefix_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "dynamic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "digest"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "budget": {
          "type": "object",
          "required": ["unit", "limit", "estimated_units", "lossless",
                       "partitions"],
          "additionalProperties": false,
          "properties": {
            "unit": {"const": "utf8_bytes_div_4"},
            "limit": {"type": "integer", "minimum": 1},
            "estimated_units": {"type": "integer", "minimum": 0},
            "lossless": {"const": true},
            "partitions": {
              "type": "object",
              "required": ["method_cards", "state_view", "graph_slice",
                           "references"],
              "additionalProperties": false,
              "properties": {
                "method_cards": {"$ref": "#/$defs/partition"},
                "state_view": {"$ref": "#/$defs/partition"},
                "graph_slice": {"$ref": "#/$defs/partition"},
                "references": {"$ref": "#/$defs/partition"}
              }
            }
          }
        },
        "cache": {
          "type": "object",
          "required": ["prefix_eligible", "prefix_scope"],
          "additionalProperties": false,
          "properties": {
            "prefix_eligible": {"const": true},
            "prefix_scope": {"const": "goal+protocol+constraints"}
          }
        }
      }
    }
  },
  "$defs": {
    "partition": {
      "type": "object",
      "required": ["estimated_units", "limit"],
      "additionalProperties": false,
      "properties": {
        "estimated_units": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1}
      }
    }
  }
}
