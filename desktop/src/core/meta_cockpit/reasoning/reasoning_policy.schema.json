{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nf-reasoning-policy.schema.json",
  "title": "NF reasoning policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "mode", "beta", "beta_cap", "search", "portfolio", "memory"],
  "properties": {
    "schema": {"const": "nf-reasoning-policy/1"},
    "version": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["auto", "search", "off"]},
    "beta": {"type": "number", "minimum": 0, "maximum": 0.5},
    "beta_cap": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_nodes", "backend", "min_gaps"],
      "properties": {
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "backend": {"type": "string", "enum": ["best_first", "puct"]},
        "min_gaps": {"type": "integer", "minimum": 0}
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "threshold"],
      "properties": {
        "enabled": {"type": "boolean"},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
