{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ninfenz.dev/schema/human-review/1",
  "title": "NF Human Review Gate",
  "description": "Residual semantic review after deterministic machine checks pass.",
  "type": "object",
  "required": ["schema", "gate_id", "pipeline", "trigger", "scope", "checklist",
               "sampling", "conformance"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "human-review/1"},
    "gate_id": {"type": "string", "pattern": "^HR-[0-9]+$"},
    "pipeline": {"type": "string", "minLength": 1},
    "trigger": {"enum": ["after-machine-pass"]},
    "scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "checklist": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/check"}
    },
    "sampling": {"$ref": "#/$defs/sampling"},
    "conformance": {"enum": ["L1", "L2"]}
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": ["id", "question", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^HR-C[0-9]+$"},
        "question": {"type": "string", "minLength": 8},
        "evidence": {"type": "string", "minLength": 8}
      }
    },
    "sampling": {
      "type": "object",
      "required": ["mode", "size"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["full", "risk_based"]},
        "size": {"type": "integer", "minimum": 1}
      }
    },
    "record": {
      "type": "object",
      "required": ["gate_id", "machine_digest", "reviewer", "at", "decision",
                   "checks", "notes"],
      "additionalProperties": false,
      "properties": {
        "gate_id": {"type": "string", "pattern": "^HR-[0-9]+$"},
        "machine_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer": {"type": "string", "minLength": 1},
        "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}"},
        "decision": {"enum": ["approve", "reject", "needs_revision"]},
        "checks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "evidence", "verdict"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^HR-C[0-9]+$"},
              "evidence": {"type": "string", "minLength": 8},
              "verdict": {"enum": ["pass", "fail", "not_applicable"]}
            }
          }
        },
        "notes": {"type": "string", "minLength": 8}
      }
    }
  }
}
